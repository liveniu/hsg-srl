.idea/
.vscode/
.venv/
__pycache__/
*.py[cod]
.DS_Store

# Licensed videos and extracted geometry databases stay on the machine that runs them.
data/external/
data/work/
*.db-wal
*.db-shm

# Board copies of the geometry databases. Support, polygons, and the seed-0
# checkpoint under reference/orin/data are part of the timing bundle.
reference/orin/data/**/geometry.db
reference/orin/work/
reference/orin/.venv/

# Fresh experiment output. Published arrays under results/ are part of the git release.
results/runs/

# Zenodo staging. The deposit is uploaded separately.
zenodo_upload/
paper/

# Detector weights and TensorRT engines. Residual checkpoints used by the tables stay.
*.engine
*.onnx
*.pt
!results/recorded/checkpoints/*.pt
!reference/orin/data/**/checkpoint_seed0.pt
